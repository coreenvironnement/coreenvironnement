# Copier vers .env.local pour le dev local.
# Sur Vercel (Production + Preview) : Project Settings → Environment Variables.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Obligatoire pour commandes, admin, webhooks Stripe (bypass RLS côté serveur)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID_PRO_MONTHLY=
# STRIPE_PRICE_ID_PRO_MONTHLY=   # optionnel si produit mensuel configuré

# URL publique du site (redirects Stripe success/cancel)
NEXT_PUBLIC_APP_URL=

# E-mails transactionnels (optionnel)
# RESEND_API_KEY=
