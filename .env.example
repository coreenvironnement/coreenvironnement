# URL publique du site (vitrine, liens e-mail, reprise ?reprise=…)
NEXT_PUBLIC_APP_URL=https://www.coreenvironnement.fr

# Notifications commandes / liste d’attente pro (défaut : contact@coreenvironnement.fr, voir lib/legal.ts)
ORDER_NOTIFICATION_EMAIL=contact@coreenvironnement.fr

# Signature des jetons « Reprendre ma commande » (≥ 16 caractères). Obligatoire en prod.
# Peut réutiliser CRON_SECRET si déjà défini (≥ 16 caractères).
DEVIS_RESUME_SECRET=

# Supabase Auth — Site URL = NEXT_PUBLIC_APP_URL
# Redirect URLs : {NEXT_PUBLIC_APP_URL}/auth/callback , http://localhost:3000/auth/callback